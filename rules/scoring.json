{"schema_version": 1,
 "limits": {"bundle_max_bytes": 262144, "scan_max_bytes": 1048576, "binary_sniff_bytes": 8192,
            "max_files_per_skill": 500, "ingest_max_bytes": 5242880, "excerpt_max_chars": 120,
            "quote_min_chars": 12, "quote_line_window": 2, "stale_clone_hours": 24,
            "clone_timeout_seconds": 300, "git_timeout_seconds": 60},
 "lint": {"name_max": 64, "desc_max": 1024, "desc_combined_max": 1536, "desc_min": 40,
          "body_max_lines": 500, "body_max_tokens": 5000, "ref_toc_lines": 100, "toc_window_lines": 30,
          "large_body_lines": 150},
 "points": {"critical": 2, "quality": 1}, "blocker_cap": 3,
 "bands": {"strong_min": 8, "adequate_min": 6},
 "risk_thresholds": {"trigger_low_max": 5, "safety_target": 8, "scripts_tools_low_max": 5},
 "report": {"top_recs_per_skill": 5, "top_issues_run": 10},
 "orchestration": {"ask_threshold_passes": 30, "batch_size": 10, "routing_calls": 3},
 "kit": {"trigger_pos_min": 8, "trigger_pos_max": 10, "trigger_neg_min": 8, "trigger_neg_max": 10,
         "sibling_neg_min": 2, "task_min": 3},
 "routing": {"recall_major_below": 0.5, "recall_minor_below": 0.8, "false_trigger_above": 0.2,
             "collision_min": 2}}
