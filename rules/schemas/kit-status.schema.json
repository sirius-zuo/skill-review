{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "skill-review kit status",
  "type": "object",
  "required": [
    "schema_version",
    "engine",
    "skill",
    "status",
    "errors"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "engine": {
      "const": "script"
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ok",
        "failed"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
