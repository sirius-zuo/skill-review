{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "skill-review manifest",
  "type": "object",
  "required": [
    "schema_version",
    "engine",
    "root",
    "source",
    "self_review",
    "skills",
    "repo_files",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "engine": {
      "const": "script"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "url",
        "clone_dir"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "local",
            "github"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "clone_dir": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "self_review": {
      "type": "boolean"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name",
          "dir",
          "skill_file",
          "kind",
          "parent",
          "files",
          "references",
          "eval_result_files"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "dir": {
            "type": "string",
            "minLength": 1
          },
          "skill_file": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "skill",
              "fixture"
            ]
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "size",
                "binary",
                "symlink",
                "hidden",
                "bundled",
                "skip_reason"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "binary": {
                  "type": "boolean"
                },
                "symlink": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "hidden": {
                  "type": "boolean"
                },
                "bundled": {
                  "type": "boolean"
                },
                "skip_reason": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "enum": [
                        "binary",
                        "too_large",
                        "symlink",
                        "file_limit",
                        "special",
                        "unreadable"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "eval_result_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "repo_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size",
          "binary",
          "symlink",
          "hidden",
          "bundled",
          "skip_reason"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "binary": {
            "type": "boolean"
          },
          "symlink": {
            "type": [
              "string",
              "null"
            ]
          },
          "hidden": {
            "type": "boolean"
          },
          "bundled": {
            "type": "boolean"
          },
          "skip_reason": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "binary",
                  "too_large",
                  "symlink",
                  "file_limit",
                  "special",
                  "unreadable"
                ]
              }
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
