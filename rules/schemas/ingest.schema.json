{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "skill-review ingest result",
  "type": "object",
  "required": [
    "schema_version",
    "engine",
    "results",
    "invalid"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "engine": {
      "const": "script"
    },
    "skill": {
      "type": "object",
      "required": [
        "key",
        "name",
        "dir",
        "skill_file"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "dir": {
          "type": "string"
        },
        "skill_file": {
          "type": "string"
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_file",
          "format",
          "skill_name",
          "date",
          "model",
          "runs_per_case",
          "n_cases",
          "with_pass_rate",
          "without_pass_rate",
          "delta",
          "trigger_precision",
          "trigger_recall",
          "stale_kit",
          "fresh",
          "warnings",
          "valid"
        ],
        "additionalProperties": false,
        "properties": {
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "enum": [
              "kit-results",
              "claude-plugin-eval",
              "skill-creator-benchmark"
            ]
          },
          "skill_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "runs_per_case": {
            "type": "integer",
            "minimum": 0
          },
          "n_cases": {
            "type": "integer",
            "minimum": 0
          },
          "with_pass_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "without_pass_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "delta": {
            "type": [
              "number",
              "null"
            ]
          },
          "trigger_precision": {
            "type": [
              "number",
              "null"
            ]
          },
          "trigger_recall": {
            "type": [
              "number",
              "null"
            ]
          },
          "stale_kit": {
            "type": "boolean"
          },
          "fresh": {
            "enum": [
              true,
              false,
              "unknown"
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    },
    "invalid": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_file",
          "format",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "source_file": {
            "type": "string"
          },
          "format": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "has_valid_result": {
      "type": "boolean"
    },
    "has_baseline": {
      "type": "boolean"
    }
  }
}
