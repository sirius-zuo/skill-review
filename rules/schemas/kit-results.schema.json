{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "skill-review kit results",
  "type": "object",
  "required": [
    "skill",
    "kit_id",
    "date",
    "runs"
  ],
  "properties": {
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "kit_id": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "arm",
          "run",
          "passed"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "arm": {
            "enum": [
              "with",
              "without"
            ]
          },
          "run": {
            "type": "integer"
          },
          "passed": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "passed"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
