       {"id": "K1-c2", "type": "file_exists", "params": {"path": "fixtures/report.md"}},
       {"id": "K1-c3", "type": "output_contains", "params": {"text": "fixed 1 heading"}},
       {"id": "K1-c4", "type": "tool_called", "params": {"tool": "Edit"}},
       {"id": "K1-c5", "type": "judge",
